# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (the bot will send order notifications here)
ADMIN_CHAT_ID=your_telegram_user_id

# Public URL where the catalog is hosted (used by the Telegram WebApp button)
WEBAPP_URL=https://your-app.railway.app

# Port for the Express server
PORT=3000

# Simple admin password for the MVP admin panel
ADMIN_PASSWORD=admin123
